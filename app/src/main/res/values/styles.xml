<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="NoTintButton">
        <item name="android:backgroundTint">@color/primary_light_variant</item>
    </style>

    <style name="PrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="backgroundTint">@color/primary_light_variant</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Reject Button Style -->
    <style name="RejectButton">
        <item name="android:textColor">@color/error</item>
        <item name="android:background">@drawable/btn_outline_error</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_height">42dp</item>
        <item name="backgroundTint">@color/text_white</item>
    </style>

    <!-- Approve Button Style -->
    <style name="ApproveButton">
        <item name="android:textColor">@color/text_white</item>
        <item name="android:background">@drawable/btn_filled_success</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_height">42dp</item>
    </style>

    <style name="header_title">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:color">@color/text_primary</item>
    </style>

    <style name="header_subtitle">
        <item name="android:textSize">14sp</item>
        <item name="android:color">@color/text_secondary</item>
    </style>

    <style name="dashboard_card">
        <item name="android:numbersBackgroundColor">#FFFF</item>
        <item name="android:radius">8dp</item>

    </style>

    <style name="product_card">
        <item name="android:radius">20dp</item>

        <item name="android:background">@color/primary_light_variant_20</item>
    </style>

    <style name="Widget.Theme.Stylica_app.MyView" parent="">
        <item name="android:background">@color/gray_400</item>
        <item name="exampleColor">@color/light_blue_400</item>
    </style>

    <style name="InputFieldStyle">
        <item name="android:background">@drawable/input_bg</item>
        <item name="android:textColor">#000000</item>
    </style>

</resources>