<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_light_variant_20"
    android:fillViewport="true"
    tools:context=".views.activities.LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/login_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="17dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="17dp"
            android:outlineSpotShadowColor="@color/primary_light_variant_20"
            android:visibility="visible"
            app:cardCornerRadius="12dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="20dp">

                <!-- STYLICA Brand -->
                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="48dp"
                    android:layout_marginEnd="32dp"
                    android:letterSpacing="0.1"
                    android:text="STYLICA"
                    android:textColor="@color/primary_light_variant"
                    android:textSize="30sp" />

                <!-- Welcome Back -->
                <TextView
                    android:id="@+id/textView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Welcome Back"
                    android:textColor="@color/text_primary"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <!-- Subtitle -->
                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginStart="45dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="45dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3sp"
                    android:text="Please sign in to continue to your boutique"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- Email Label -->
                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="45dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="45dp"
                    android:lineSpacingExtra="3sp"
                    android:text="Email Address"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- Email Field -->
                <LinearLayout
                    android:id="@+id/linearLayout3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="45dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="45dp"
                    android:background="@drawable/rounded_field_shape"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp">

                    <EditText
                        android:id="@+id/email_field"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:ems="10"
                        android:hint="botique@stylica.com"
                        android:inputType="textEmailAddress" />

                    <ImageView
                        android:id="@+id/imageView2"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        app:srcCompat="@drawable/mail" />

                </LinearLayout>

                <!-- Password Label -->
                <TextView
                    android:id="@+id/textView8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="45dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="45dp"
                    android:lineSpacingExtra="3sp"
                    android:text="Password"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- Password Field -->
                <LinearLayout
                    android:id="@+id/linearLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="45dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="45dp"
                    android:background="@drawable/rounded_field_shape"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp">

                    <EditText
                        android:id="@+id/password_field"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:ems="10"
                        android:hint="••••••••"
                        android:inputType="textPassword" />

                    <LinearLayout
                        android:id="@+id/show_hide_passwd_btn"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:gravity="center"
                        android:onClick="showOrHidePasswd"
                        android:paddingStart="10dp">

                        <ImageView
                            android:id="@+id/show_hide_passwd_icon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="eye icon"
                            android:src="@drawable/eye_on" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="45dp"
                    android:padding="5dp"
                    >
                    <TextView
                        android:id="@+id/forgotPasswordTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Forgot Password"
                        android:textColor="@color/primary_light_variant"
                        />
                </LinearLayout>
                <!--CAPTCHA SECTION  -->
                <LinearLayout
                    android:id="@+id/captchaSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="45dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="45dp"
                    android:orientation="vertical">

                    <!-- Captcha Label -->
                    <TextView
                        android:id="@+id/textCaptchaHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:lineSpacingExtra="3sp"
                        android:text="Captcha Verification"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <!-- Captcha Display Row: Code + Refresh -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Captcha Code Box -->
                        <TextView
                            android:id="@+id/captcha_text"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_field_shape"
                            android:fontFamily="monospace"
                            android:gravity="center"
                            android:letterSpacing="0.3"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="@color/primary_light_variant"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <!-- Refresh Button -->
                        <ImageView
                            android:id="@+id/captcha_refresh_btn"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="10dp"
                            android:contentDescription="Refresh captcha"
                            android:onClick="refreshCaptcha"
                            android:padding="10dp"
                            android:src="@drawable/refresh_icon" />

                    </LinearLayout>

                    <!-- Captcha Input Field -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/rounded_field_shape"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp">

                        <EditText
                            android:id="@+id/captcha_input"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@null"
                            android:hint="Enter captcha above"
                            android:inputType="textNoSuggestions"
                            android:maxLength="6"
                            android:textSize="15sp" />

                    </LinearLayout>

                </LinearLayout>
                <!--END CAPTCHA SECTION -->

                <!-- Loader -->
                <ProgressBar
                    android:id="@+id/loader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:indeterminateTint="@color/primary_light_variant"
                    android:visibility="gone" />

                <!-- Sign In Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/login_btn"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginStart="45dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="45dp"
                    android:backgroundTint="@color/primary_light_variant"
                    android:onClick="login"
                    android:text="Sign In"
                    android:textSize="16sp"
                    android:visibility="visible"
                    app:cornerRadius="8dp" />

                <!-- Sign Up Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="45dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginEnd="45dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="3dp"
                        android:text="Don't have an account ?"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <Space
                        android:layout_width="4dp"
                        android:layout_height="20dp" />

                    <TextView
                        android:id="@+id/signup_screen_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="3dp"
                        android:text="Sign Up"
                        android:textColor="@color/primary_light_variant"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>