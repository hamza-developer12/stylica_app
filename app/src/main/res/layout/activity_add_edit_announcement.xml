<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:fitsSystemWindows="true"
    >

    <include layout="@layout/custom_app_bar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="30dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Title"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/edtTitle"
                style="@style/InputFieldStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter announcement title"
                android:padding="15dp"
                android:layout_marginBottom="12dp"/>

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/edtDescription"
                style="@style/InputFieldStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter description"
                android:inputType="textMultiLine"
                android:lines="4"
                android:gravity="top|start"
                android:padding="15dp"
                android:layout_marginBottom="12dp"/>

            <!-- Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Type"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="4dp"/>

            <!-- Type Chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/chipNews"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="News"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:textColor="@color/text_white"
                    android:background="@drawable/chip_selected_bg"/>



                <TextView
                    android:id="@+id/chipEvent"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Event"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/chip_unselected_bg"/>

                <TextView
                    android:id="@+id/chipGeneral"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="General"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/chip_unselected_bg"/>

            </LinearLayout>

            <!-- Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:id="@+id/datePickerBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/search_bar_bg"
                android:padding="15dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/txtSelectedDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Select Date"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅"
                    android:textSize="18sp"/>

            </LinearLayout>

            <!-- Save Button -->
            <Button
                android:id="@+id/btnSave"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Save"/>

            <!-- Loader -->
            <ProgressBar
                android:id="@+id/loader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/primary_light_variant"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>